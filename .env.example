# Copy this to .env and fill in your values
ANTHROPIC_API_KEY=

# PostgreSQL password — used by both the db service and the web service
POSTGRES_PASSWORD=

# Optional: defaults to a dev key if not set
# SECRET_KEY=

# Optional: defaults to False if not set
# DEBUG=false

# Optional: Claude model to use (defaults to claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6
