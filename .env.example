# Copy this to .env and fill in your values
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: defaults to SQLite if not set
# DATABASE_URL=postgresql://user:password@localhost:5432/codefusion

# Optional: defaults to a dev key if not set
# SECRET_KEY=your-secret-key-here

# Optional: Claude model to use (defaults to claude-sonnet-4-6)
# CLAUDE_MODEL=claude-sonnet-4-6
